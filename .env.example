# Existing integrations
GOOGLE_CALENDAR_API_KEY=replace_with_google_calendar_api_key
SESSION_SECRET=replace_with_at_least_32_random_characters

# Public Sanity content connection (server-side)
SANITY_PROJECT_ID=replace_with_sanity_project_id
SANITY_DATASET=production
SANITY_API_READ_TOKEN=replace_with_viewer_token_for_draft_previews
BLOG_PREVIEW_SECRET=replace_with_a_long_random_preview_secret
PUBLIC_SITE_URL=https://columbiafounders.com

# Public build-time feature flag. Set in Replit Secrets for development and deployment.
VITE_BLOG_ENABLED=true
